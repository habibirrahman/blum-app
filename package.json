{
  "name": "blum-app",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "run-p build-only",
    "build-check": "run-p type-check \"build-only {@}\" --",
    "build-dev": "run-p type-check \"build-only-dev {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "build-only-dev": "NODE_ENV=development vite build --mode development",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/media": "^8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@headlessui/vue": "^1.7.23",
    "@iconify/vue": "^4.3.0",
    "axios": "1.20.0",
    "dayjs": "^1.11.23",
    "pinia": "^2.3.1",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.3",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/json": "^2.2.548",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/node20": "^20.1.10",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^24.1.3",
    "npm-run-all2": "^6.2.6",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "tailwindcss-safe-area": "0.8.0",
    "typescript": "~5.8.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.2.12"
  }
}
